{
  "name": "Minimal (3 folders)",
  "description": "Only three folders: Documents, Media (photos, videos, music) and Other. For people who want the least clutter.",
  "config": {
    "topics": {},
    "unknown_extensions": {
      "enabled": false,
      "min_files": 1
    }
  },
  "rules_replace": [
    {
      "name": "Documents",
      "extensions": [
        ".pdf",
        ".docx",
        ".doc",
        ".pptx",
        ".ppt",
        ".odp",
        ".key",
        ".xlsx",
        ".xls",
        ".xlsm",
        ".csv",
        ".ods",
        ".xml",
        ".txt",
        ".rtf",
        ".odt",
        ".md"
      ],
      "dest": "Documents"
    },
    {
      "name": "Media",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp",
        ".bmp",
        ".tiff",
        ".svg",
        ".heic",
        ".mp4",
        ".mkv",
        ".mov",
        ".avi",
        ".wmv",
        ".webm",
        ".mp3",
        ".wav",
        ".flac",
        ".aac",
        ".ogg",
        ".m4a"
      ],
      "dest": "Media"
    },
    {
      "name": "Everything else",
      "extensions": [
        ".zip",
        ".rar",
        ".7z",
        ".tar",
        ".gz",
        ".exe",
        ".msi",
        ".dmg",
        ".iso",
        ".py",
        ".c",
        ".cpp",
        ".h",
        ".java",
        ".js",
        ".html",
        ".css",
        ".json",
        ".hex",
        ".bin"
      ],
      "dest": "Other"
    }
  ]
}